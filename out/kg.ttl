@prefix kg: <http://example.org/kg/23p-3007/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

kg:Albert_Einstein a kg:Person ;
    rdfs:label "Albert Einstein" ;
    kg:bornIn kg:Ulm ;
    kg:educatedAt kg:Catholic_elementary_school ;
    kg:receivedAward kg:Nobel_Prize,
        kg:Nobel_Prize_in_Physics,
        kg:prize ;
    kg:worksAt kg:Academy,
        kg:Humboldt_University_of_Berlin,
        kg:Prussian_Academy_of_Sciences .

kg:Antoine_Henri_Becquerel a kg:Person ;
    rdfs:label "Antoine Henri Becquerel" ;
    kg:bornIn kg:Paris .

kg:Lev_Landau a kg:Person ;
    rdfs:label "Lev Landau" ;
    kg:educatedAt kg:Baku_Economical_Technical_School ;
    kg:receivedAward kg:Nobel_Prize_in_Physics,
        kg:Stalin_Prize ;
    kg:worksAt kg:Niels_Bohr_s_Institute_for_Theoretical_Physics .

kg:Louis_de_Broglie a kg:Person ;
    rdfs:label "Louis de Broglie" ;
    kg:receivedAward kg:Kalinga_Prize,
        kg:Nobel_Prize_in_Physics ;
    kg:worksAt kg:Le_Conseil_de_l_Union_Catholique_des_Scientifiques_Francais .

kg:Pierre_Raymond a kg:Person ;
    rdfs:label "Pierre Raymond" ;
    kg:bornIn kg:Dieppe .

kg:Saba_Hashmi a kg:Person ;
    rdfs:label "Saba Hashmi" ;
    kg:bornIn kg:Gujranwala ;
