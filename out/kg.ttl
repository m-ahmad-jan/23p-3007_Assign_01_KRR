    kg:educatedAt kg:Calder_College_of_Science,
        kg:Northgate_Institute_of_Physics ;
    kg:receivedAward kg:Riverbend_Gold_Medal ;
    kg:worksAt kg:Westmere_College_of_Science .

kg:UNESCO a kg:Person ;
