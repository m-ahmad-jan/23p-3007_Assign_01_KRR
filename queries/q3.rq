PREFIX kg:   <http://example.org/kg/23p-3007/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?person1 ?person2 ?birthplace
WHERE {
  ?p1 kg:bornIn ?place .
  ?p2 kg:bornIn ?place .
  FILTER(STR(?p1) < STR(?p2))
  ?p1 rdfs:label ?person1 .
  ?p2 rdfs:label ?person2 .
  ?place rdfs:label ?birthplace .
}